<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- 背景の星/波紋アニメーション用View -->
    <View
        android:id="@+id/view_pulse_bg"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_alarm_pulse"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_alarm_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp" />

    <!-- アラームアイコン -->
    <ImageView
        android:id="@+id/iv_alarm_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_alarm_large"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="@id/view_pulse_bg"
        app:layout_constraintBottom_toBottomOf="@id/view_pulse_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- アラームラベル -->
    <TextView
        android:id="@+id/tv_alarm_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="アラーム"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tv_current_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <!-- 現在時刻 -->
    <TextView
        android:id="@+id/tv_current_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="07:00"
        android:textColor="@color/colorAccent"
        android:textSize="56sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-light"
        app:layout_constraintBottom_toTopOf="@id/btn_snooze"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp" />

    <!-- スヌーズボタン -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_snooze"
        android:layout_width="160dp"
        android:layout_height="56dp"
        android:text="スヌーズ(5分)"
        android:textColor="#FFFFFF"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="#9E9E9E"
        app:strokeWidth="1dp"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toTopOf="@id/btn_stop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- アラーム停止ボタン -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_stop"
        android:layout_width="200dp"
        android:layout_height="64dp"
        android:text="停 止"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/colorAccent"
        app:cornerRadius="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="64dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
